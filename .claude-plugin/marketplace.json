{
  "name": "bretfisher",
  "owner": {
    "name": "Bret Fisher",
    "url": "https://www.bretfisher.com"
  },
  "description": "Bret Fisher's agent skills: opinionated DevOps and platform engineering skills tested with evals, plus small developer utilities",
  "plugins": [
    {
      "name": "bretfisher-devops",
      "displayName": "Bret Fisher DevOps Skills",
      "source": "./plugins/devops",
      "description": "Opinionated DevOps and platform engineering skills from a Docker Captain: Dockerfiles and Compose, GitHub Actions workflows and audits, production Kubernetes pod specs, recent Kubernetes features, and local linting setup. Tested with evals.",
      "category": "devops",
      "tags": [
        "docker",
        "compose",
        "github-actions",
        "ci-cd",
        "kubernetes",
        "linting",
        "security"
      ],
      "keywords": [
        "docker",
        "dockerfile",
        "docker-compose",
        "buildkit",
        "github-actions",
        "ci-cd",
        "kubernetes",
        "helm",
        "kustomize",
        "pod-security",
        "linting",
        "super-linter",
        "devops",
        "platform-engineering",
        "sre"
      ],
      "author": {
        "name": "Bret Fisher",
        "url": "https://www.bretfisher.com"
      },
      "homepage": "https://github.com/BretFisher/skills#readme",
      "repository": "https://github.com/BretFisher/skills",
      "license": "MIT",
      "relevance": {
        "topic": "DevOps",
        "signals": {
          "cli": [
            "docker",
            "kubectl",
            "helm",
            "kustomize",
            "actionlint",
            "zizmor"
          ],
          "filesRead": [
            "**/Dockerfile",
            "**/*.Dockerfile",
            "**/compose.y*ml",
            "**/docker-compose*.y*ml",
            "**/docker-bake.hcl",
            "**/.github/workflows/*.y*ml",
            "**/Chart.yaml",
            "**/kustomization.y*ml"
          ]
        }
      }
    },
    {
      "name": "bretfisher-utils",
      "displayName": "Bret Fisher Utilities",
      "source": "./plugins/utils",
      "description": "Small developer utilities for agents, such as screencapture-mac, which lets the agent screenshot native macOS apps to see what you see.",
      "category": "utilities",
      "tags": ["macos", "screenshot", "gui", "desktop"],
      "keywords": [
        "macos",
        "screenshot",
        "screencapture",
        "gui",
        "desktop-apps",
        "swiftui"
      ],
      "author": {
        "name": "Bret Fisher",
        "url": "https://www.bretfisher.com"
      },
      "homepage": "https://github.com/BretFisher/skills#readme",
      "repository": "https://github.com/BretFisher/skills",
      "license": "MIT"
    }
  ],
  "renames": {
    "bretfisher-skills": "bretfisher-devops"
  }
}
