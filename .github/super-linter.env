# Denylist only — list just the linters we DON'T want to run.
# Everything else stays ON by default, so new super-linter linters and any new
# file types added to this repo (e.g. a future skill that ships code) get linted
# automatically. Do NOT set any VALIDATE_*=true here: a single =true flips
# super-linter into allowlist mode and disables everything you didn't name.

# copy/paste detector — noisy on docs/examples with repeated prose and sample code
VALIDATE_JSCPD=false

# shfmt is an opinionated shell *formatter*; shellcheck already lints shell scripts
VALIDATE_SHELL_SHFMT=false

# editorconfig-checker is generic and flags many false positives;
# file-type-specific linters are better
VALIDATE_EDITORCONFIG=false

# textlint terminology rules (repo -> repository, git -> Git) fight the house style of these docs
VALIDATE_NATURAL_LANGUAGE=false
