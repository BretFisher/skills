[codespell]
# codespell settings for the `codespell` check in .dagger/modules/lint.
check-hidden =
# .agents is vendored upstream code; .dagger/modules/*/{sdk,clients} is generated.
skip = package-lock.json,*/package-lock.json,*/go.mod,*/go.sum,*.log,.git,*.lock,./.agents,./.dagger/modules/*/sdk,./.dagger/modules/*/clients
# Correct as written: notin (Kubernetes NotIn operator), froms (Dockerfile FROM lines), edn (Clojure file
# type), regraded (graded again), and the regex fragments cach and assum.
ignore-words-list = notin,froms,edn,regraded,cach,assum
